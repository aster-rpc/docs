---
import './diagram.css';
const steps = [
  ['Open bidirectional stream', 'Client → server', 'QUIC'],
  ['StreamHeader', 'Client → server', 'AEv1 · HEADER'],
  ['Request payload', 'Client → server', 'Fory XLANG'],
  ['Response payload', 'Server → client', 'Fory XLANG'],
  ['RpcStatus: OK', 'Server → client', 'AEv1 · TRAILER'],
];
---
<figure class="aster-diagram not-content">
  <svg viewBox="0 0 480 490" role="img" aria-label="A successful unary RPC: open a QUIC stream, send a header and request, then receive a response and an OK status trailer.">
    <title>A successful unary call</title>
    <text class="title" x="12" y="26">One call stream</text>
    {steps.map(([title, direction, encoding], i) => <g>
      {i < 4 && <path class="arrow" d={`M30 ${i * 88 + 78} V${i * 88 + 140}`} />}
      <circle class={i < 3 ? 'box-muted' : 'box'} cx="30" cy={i * 88 + 78} r="18" />
      <text class="sub" x="30" y={i * 88 + 83} text-anchor="middle">{i + 1}</text>
      <rect class={i < 3 ? 'box-muted' : 'box'} x="66" y={i * 88 + 48} width="402" height="70" rx="6" />
      <text class="title" x="82" y={i * 88 + 76}>{title}</text>
      <text class="sub" x="82" y={i * 88 + 99}>{direction} · {encoding}</text>
    </g>)}
  </svg>
  <figcaption>Headers and trailers use AEv1. Only application payloads use Fory. Streaming calls carry additional payload frames.</figcaption>
</figure>
